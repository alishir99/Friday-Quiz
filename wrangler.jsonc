{
  // Deployed straight from the repository - there is no build step, because
  // the app has no dependencies and needs none.
  "name": "quizzy",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",

  // public/ is the app itself. ORIGIN (the VM's address) is set in the
  // dashboard rather than here, so the repository does not carry it.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
