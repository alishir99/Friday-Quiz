# systemd unit for Friday Quiz.
#
#   sudo cp deploy/friday-quiz.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now friday-quiz
#
# Logs:    journalctl -u friday-quiz -f
# Restart: sudo systemctl restart friday-quiz

[Unit]
Description=Friday Quiz
After=network.target

[Service]
Type=simple
User=quiz
WorkingDirectory=/opt/friday-quiz
ExecStart=/usr/bin/node server.mjs

# Caddy terminates TLS and proxies to this port, so the app itself only needs
# to listen on loopback - the plain-HTTP port is then unreachable from outside.
Environment=PORT=8080
Environment=QUIZ_BIND=127.0.0.1

# Secrets and the invite code live in this file, not in the unit, so they stay
# out of `systemctl show` and out of git.
EnvironmentFile=/opt/friday-quiz/.env

Restart=always
RestartSec=3

# The app only ever needs to write its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/friday-quiz/data

[Install]
WantedBy=multi-user.target
